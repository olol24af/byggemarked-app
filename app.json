{
  "expo": {
    "name": "ByggeMarked",
    "slug": "byggemarked-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF7F0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7F0"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ByggeMarked bruger dine billeder, så du kan vise materialet i din annonce.",
          "cameraPermission": "ByggeMarked bruger kameraet, så du kan tage et billede af materialet til din annonce."
        }
      ]
    ]
  }
}
